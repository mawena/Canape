[Unit]
Description=Canapé, regarder un film à deux, chacun chez soi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=canape
Group=canape
# Le code vit dans /opt/canape/versions/<version>-<commit>/ ; « actuelle » est un lien changé de façon atomique
# par deploiement/mettre-a-jour. Node (copié dans /opt/canape/node) exécute le TypeScript directement.
WorkingDirectory=/opt/canape/actuelle
EnvironmentFile=/etc/canape/canape.conf
ExecStart=/opt/canape/node/bin/node /opt/canape/actuelle/serveur/src/index.ts serve
Restart=on-failure
RestartSec=3
UMask=0027

# Les autres sites du serveur passent avant : les conversions vidéo (ffmpeg, lancé par le service) ne prennent que
# la moitié du poids habituel pour le processeur et le disque.
CPUWeight=50
IOWeight=50

# Durcissement : seul /srv/canape (base, films, cache, envois en cours) est inscriptible.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/canape
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# @pkey : V8 (le moteur de Node) protège sa mémoire par pkey_alloc/pkey_mprotect ; sans lui Node meurt au démarrage.
# Un appel refusé renvoie EPERM au lieu de tuer le service.
SystemCallFilter=@system-service @pkey
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
# Node n'écoute qu'en local (nginx est devant) : aucune capacité nécessaire.
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
