# Réglages de Canapé : /etc/canape/canape.conf (format CLÉ=valeur, # pour un commentaire).
# Propriétaire root, groupe canape, droits 640. Après une modification : sudo systemctl restart canape
# Toutes les variables : docs/CONCEPTION.md (section Configuration). Les comptes ont remplacé le mot de passe commun
# et le secret de la 0.1 : CANAPE_MOT_DE_PASSE et CANAPE_SECRET n'existent plus.

# Adresse et port d'écoute. En production Node reste en local, nginx est devant.
CANAPE_HOTE=127.0.0.1
CANAPE_PORT=8080

# Adresse publique : liens d'invitation et contrôle d'Origin des requêtes qui modifient.
CANAPE_URL_PUBLIQUE=https://canape.exemple.fr

# 1 = faire confiance à X-Forwarded-Proto / X-Forwarded-For de nginx (cookie Secure, adresse du visiteur).
CANAPE_DERRIERE_PROXY=1

# Dossiers (sous /srv/canape : le seul endroit où le service peut écrire).
CANAPE_DONNEES=/srv/canape/donnees
CANAPE_FILMS=/srv/canape/films
CANAPE_CACHE=/srv/canape/cache
CANAPE_TELEVERSEMENTS=/srv/canape/televersements
CANAPE_TELECHARGEMENTS=/srv/canape/telechargements

# Limites (valeurs par défaut) :
#CANAPE_TELEVERSEMENT_MAX=100G
#CANAPE_QUOTA_DEFAUT=100G
#CANAPE_CACHE_MAX=20G
# Conversions vidéo : fils ffmpeg (défaut : la moitié des cœurs) et priorité nice (les autres sites passent avant).
#CANAPE_TRANSCODAGE_FILS=2
#CANAPE_TRANSCODAGE_PRIORITE=10
#CANAPE_PREPARATION_AUTO=1

# Films par torrent (lien magnet ou fichier .torrent). Le moteur tourne dans un processus enfant, en nice
# (CANAPE_TRANSCODAGE_PRIORITE). Valeurs par défaut :
#CANAPE_TORRENTS=1
#CANAPE_TORRENT_SIMULTANES=2
# Octets par seconde (0 = sans limite) ; 20M accepté.
#CANAPE_TORRENT_DEBIT_MAX=0
#CANAPE_TORRENT_ENVOI_MAX=1M
# Ratio de partage après la fin (0 = on arrête dès que le film est reçu).
#CANAPE_TORRENT_PARTAGE=0
# Port des pairs (0 = au hasard) : un port fixe, ouvert dans le pare-feu (TCP et UDP), aide beaucoup.
#CANAPE_TORRENT_PORT=51413

# Affiches et résumés des films (clé gratuite sur themoviedb.org).
#CANAPE_TMDB_CLE=

# Serveurs STUN/TURN donnés aux navigateurs (JSON). Défaut : un STUN public de Google.
#CANAPE_ICE=[{"urls":"stun:stun.l.google.com:19302"}]

# Relais TURN (coturn) pour les réseaux stricts : URL séparées par des virgules, et le secret partagé
# (static-auth-secret de coturn). Canapé en tire des identifiants temporaires pour chaque navigateur.
#CANAPE_TURN_URLS=turn:canape.exemple.fr:3478
#CANAPE_TURN_SECRET=

# HTTPS servi directement par Node : inutile derrière nginx.
#CANAPE_TLS_CERT=
#CANAPE_TLS_CLE=
