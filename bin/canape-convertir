#!/usr/bin/env bash
# canape-convertir : prépare un film pour le navigateur (MP4 H.264 + AAC, +faststart)
# et extrait les sous-titres texte intégrés en .vtt.
set -euo pipefail

aide() {
  cat <<'TXT'
Utilisation : canape-convertir [options] <film> [<film>...]

Convertit chaque film en MP4 (vidéo H.264, son AAC stéréo, +faststart) lisible par tous les navigateurs,
et extrait les sous-titres texte intégrés (SubRip, ASS, mov_text) en fichiers .vtt à côté du film.

Le résultat est écrit à côté de l'original :
  Film.mkv  ->  Film.mp4          (Film.mp4 existant -> Film.navigateur.mp4)
  sous-titres -> Film.<langue>.vtt

Options :
  -f, --forcer   écrase les fichiers de sortie qui existent déjà
      --aide     affiche ce message

Prérequis : ffmpeg et ffprobe. La conversion est un travail lourd (plusieurs minutes, tous les cœurs).
TXT
}

forcer=0
films=()
for a in "$@"; do
  case "$a" in
    --aide|-h|--help) aide; exit 0 ;;
    -f|--forcer) forcer=1 ;;
    -*) echo "Option inconnue : $a" >&2; aide >&2; exit 2 ;;
    *) films+=("$a") ;;
  esac
done

if [ "${#films[@]}" -eq 0 ]; then aide >&2; exit 2; fi
for outil in ffmpeg ffprobe; do
  command -v "$outil" >/dev/null 2>&1 || { echo "Erreur : $outil est introuvable (sudo apt install ffmpeg)." >&2; exit 1; }
done

erreurs=0
for film in "${films[@]}"; do
  if [ ! -f "$film" ]; then echo "Introuvable : $film" >&2; erreurs=$((erreurs + 1)); continue; fi
  dossier=$(dirname -- "$film")
  nom=$(basename -- "$film")
  base="${nom%.*}"
  ext="${nom##*.}"
  sortie="$dossier/$base.mp4"
  if [ "${ext,,}" = "mp4" ]; then sortie="$dossier/$base.navigateur.mp4"; fi

  if [ -e "$sortie" ] && [ "$forcer" -ne 1 ]; then
    echo "Déjà présent : $sortie (utilisez --forcer pour l'écraser)"; continue
  fi

  codec_video=$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$film" || true)
  format_pix=$(ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt -of csv=p=0 "$film" || true)
  if [ "$codec_video" = "h264" ] && [ "$format_pix" = "yuv420p" ]; then
    video=(-c:v copy)
    echo "== $nom : vidéo H.264 déjà compatible, recopiée sans perte"
  else
    video=(-c:v libx264 -preset medium -crf 20 -pix_fmt yuv420p)
    echo "== $nom : vidéo ré-encodée en H.264"
  fi

  tmp="$dossier/.$base.en-cours.mp4"
  if ffmpeg -hide_banner -loglevel warning -stats -y -i "$film" \
      -map 0:v:0 -map '0:a:0?' "${video[@]}" -c:a aac -b:a 192k -ac 2 \
      -sn -dn -movflags +faststart -f mp4 "$tmp"; then
    mv -f -- "$tmp" "$sortie"
    echo "   -> $sortie"
  else
    rm -f -- "$tmp"; echo "Échec de la conversion de $nom" >&2; erreurs=$((erreurs + 1)); continue
  fi

  # Sous-titres texte intégrés
  while IFS=, read -r index codec langue; do
    [ -n "${index:-}" ] || continue
    case "$codec" in subrip|srt|ass|ssa|mov_text|webvtt|text) ;; *) continue ;; esac
    langue="${langue:-}"; [ "$langue" = "und" ] && langue=""
    # ffmpeg donne des codes ISO 639-2 (fra, eng…) ; le serveur et le navigateur attendent 639-1 (fr, en…)
    case "${langue,,}" in
      fra|fre) langue=fr ;; eng) langue=en ;; spa) langue=es ;; deu|ger) langue=de ;; ita) langue=it ;;
      por) langue=pt ;; nld|dut) langue=nl ;; *) langue="${langue,,}" ;;
    esac
    suffixe="${langue:+.$langue}"
    vtt="$dossier/$base$suffixe.vtt"
    if [ -e "$vtt" ] && [ "$forcer" -ne 1 ]; then continue; fi
    if ffmpeg -hide_banner -loglevel error -y -i "$film" -map "0:$index" -c:s webvtt "$vtt"; then
      echo "   sous-titres -> $vtt"
    else
      rm -f -- "$vtt"
    fi
  done < <(ffprobe -v error -select_streams s -show_entries stream=index,codec_name:stream_tags=language -of csv=p=0 "$film" || true)
done

[ "$erreurs" -eq 0 ]
