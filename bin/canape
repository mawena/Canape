#!/bin/sh
# Lance Canapé : Node de /opt/canape (VPS) s'il existe, sinon celui du PATH (>= 24).
dossier=$(cd "$(dirname "$0")/.." && pwd -P)
if [ -x /opt/canape/node/bin/node ]; then
  NODE=/opt/canape/node/bin/node
else
  NODE=$(command -v node) || { echo "Canapé : Node.js introuvable (version 24 ou plus requise)." >&2; exit 1; }
fi
majeure=$("$NODE" -p 'process.versions.node.split(".")[0]' 2>/dev/null)
if [ -z "$majeure" ] || [ "$majeure" -lt 24 ]; then
  echo "Canapé : Node.js 24 ou plus requis (trouvé : $("$NODE" -v 2>/dev/null || echo aucun) dans $NODE)." >&2
  exit 1
fi
exec "$NODE" --disable-warning=ExperimentalWarning "$dossier/serveur/src/index.ts" "$@"
