[Unit]
Description=Canapé, regarder un film à deux chacun chez soi
Documentation=https://mawena.github.io/Canape/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=canape
Group=canape
# secrets.conf (créé à l'installation) d'abord, canape.conf ensuite : ce dernier l'emporte.
EnvironmentFile=-/etc/canape/secrets.conf
EnvironmentFile=-/etc/canape/canape.conf
ExecStart=/usr/bin/canape
Restart=on-failure
RestartSec=3
UMask=0027

# Durcissement : le service ne peut écrire que dans /var/lib/canape ; les films (n'importe où en lecture) restent lisibles.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/canape
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
# Un port inférieur à 1024 (80, 443) reste possible sans être root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
